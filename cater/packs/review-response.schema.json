{
  "type": "object", "additionalProperties": false, "required": ["checks"],
  "properties": {"checks": {"type": "array", "maxItems": 32, "items": {
    "type": "object", "additionalProperties": false,
    "required": ["id", "status", "reason", "artifact_seq", "quote", "receipt_seq"],
    "properties": {
      "id": {"type": "string"},
      "status": {"type": "string", "enum": ["passed", "failed", "unknown"]},
      "reason": {"type": "string", "minLength": 1, "maxLength": 2000},
      "artifact_seq": {"type": ["integer", "null"]},
      "quote": {"type": "string", "maxLength": 2000, "description": "An exact contiguous excerpt, not a paraphrase or ellipsis. For unknown with no available citation, use empty quote and null artifact_seq."},
      "receipt_seq": {"type": ["integer", "null"], "description": "Exact current local-check receipt for relevance assessment, null for review-only criteria."}
    }
  }}}
}
